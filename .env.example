# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
# Interfaz de escucha. Nunca 0.0.0.0: quien expone al exterior es el proxy.
#   - proxy nativo en la misma máquina  → 127.0.0.1
#   - proxy DENTRO de un contenedor     → la puerta del puente Docker,
#     normalmente 172.17.0.1. Con 127.0.0.1 el contenedor no llegaría,
#     porque ahí dentro «localhost» es el propio contenedor.
HOST=127.0.0.1
LOG_LEVEL=info

# IP o CIDR del reverse proxy, para que Fastify se fíe de X-Forwarded-For.
# Nunca lo pongas a `true`: cualquiera podría falsear su IP y el rate limit
# por IP dejaría de servir para nada.
#   - proxy nativo             → 127.0.0.1
#   - proxy en un contenedor   → su red, p. ej. 172.17.0.0/16
TRUST_PROXY=127.0.0.1

# ── Hostnames ─────────────────────────────────────────────────────────────────
# Fallback cuando la petición no trae un host válido (o no viene del proxy).
PUBLIC_BASE_URL=https://bayeux.example.net

# Lista blanca de hosts que el servicio puede reflejar en el HTML. Todos los
# subdominios que apunten a este proceso tienen que estar aquí; uno que no esté
# cae al PUBLIC_BASE_URL en vez de colarse en las meta etiquetas.
ALLOWED_HOSTS=bayeux.example.net,tirax.example.net,panox.example.net

# Opcional: layout por defecto de un host concreto, sin pasar ?layout=.
# HOST_LAYOUTS=tirax.example.net=row,panox.example.net=grid

# ── API upstream ──────────────────────────────────────────────────────────────
FX_API_BASE=https://api.fxtwitter.com
FETCH_TIMEOUT_MS=6000
OUTBOUND_USER_AGENT=Bayeux/0.1 (+https://github.com/JosueMeserom/bayeux)

# ── Composición ───────────────────────────────────────────────────────────────
MAX_PHOTOS=4
# Altura común a la que se normalizan los paneles. Acota la memoria.
MAX_HEIGHT=1200
# Presupuesto total de píxeles del lienzo. Si se pasa, la altura baja sola.
MAX_PIXELS=12000000
MAX_DOWNLOAD_BYTES=12582912
# Separación entre paneles, en píxeles, y color del lienzo.
GAP=6
BG_COLOR=#000000
JPEG_QUALITY=88

# Dispersión relativa de alturas tolerada para decidir que es una tira:
# (max-min)/max. 0.02 = 2%.
ROW_HEIGHT_TOLERANCE=0.02
# Lo mismo sobre el aspecto (w/h). Desactivado por defecto: exigirlo rechazaría
# cortes verticales legítimos, donde los anchos varían y las alturas no.
# ROW_ASPECT_TOLERANCE=0.05

# ── Caché en disco ────────────────────────────────────────────────────────────
CACHE_DIR=./cache
CACHE_MAX_BYTES=536870912
CACHE_MAX_AGE_DAYS=30

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ── Branding ──────────────────────────────────────────────────────────────────
SITE_NAME=Bayeux
THEME_COLOR=#1d1f23
REPO_URL=https://github.com/JosueMeserom/bayeux
