# Each comment comes first in English and then in Spanish.
# Cada comentario va primero en inglés y después en español.

# ── Server / Servidor ─────────────────────────────────────────────────────────
PORT=3000
# Listening interface. Never 0.0.0.0: the proxy is what exposes it outside.
#   - native proxy on the same machine  → 127.0.0.1
#   - proxy INSIDE a container          → the gateway of the Docker bridge,
#     usually 172.17.0.1. With 127.0.0.1 the container would not reach it,
#     because in there "localhost" is the container itself.
# Interfaz de escucha. Nunca 0.0.0.0: quien expone al exterior es el proxy.
#   - proxy nativo en la misma máquina  → 127.0.0.1
#   - proxy DENTRO de un contenedor     → la puerta del puente Docker,
#     normalmente 172.17.0.1. Con 127.0.0.1 el contenedor no llegaría,
#     porque ahí dentro «localhost» es el propio contenedor.
HOST=127.0.0.1
LOG_LEVEL=info

# IP or CIDR of the reverse proxy, so Fastify trusts X-Forwarded-For.
# Never set it to `true`: anyone could fake their IP and the per-IP rate
# limit would be useless.
#   - native proxy            → 127.0.0.1
#   - proxy in a container    → its network, e.g. 172.17.0.0/16
# IP o CIDR del reverse proxy, para que Fastify se fíe de X-Forwarded-For.
# Nunca lo pongas a `true`: cualquiera podría falsear su IP y el rate limit
# por IP dejaría de servir para nada.
#   - proxy nativo             → 127.0.0.1
#   - proxy en un contenedor   → su red, p. ej. 172.17.0.0/16
TRUST_PROXY=127.0.0.1

# ── Hostnames ─────────────────────────────────────────────────────────────────
# Fallback when the request has no valid host (or does not come from the proxy).
# Fallback cuando la petición no trae un host válido (o no viene del proxy).
PUBLIC_BASE_URL=https://bayeux.example.net

# Allowlist of hosts the service may reflect in the HTML. Every subdomain that
# points to this process has to be here; one that is not falls back to
# PUBLIC_BASE_URL instead of getting into the meta tags.
# Lista blanca de hosts que el servicio puede reflejar en el HTML. Todos los
# subdominios que apunten a este proceso tienen que estar aquí; uno que no esté
# cae al PUBLIC_BASE_URL en vez de colarse en las meta etiquetas.
ALLOWED_HOSTS=bayeux.example.net,tirax.example.net,panox.example.net

# Optional: default layout for a specific host, without passing ?layout=.
# Opcional: layout por defecto de un host concreto, sin pasar ?layout=.
# HOST_LAYOUTS=tirax.example.net=row,panox.example.net=grid

# ── Upstream API / API upstream ───────────────────────────────────────────────
FX_API_BASE=https://api.fxtwitter.com
FETCH_TIMEOUT_MS=6000
OUTBOUND_USER_AGENT=Bayeux/0.1 (+https://github.com/JosueMeserom/bayeux)

# ── Composition / Composición ─────────────────────────────────────────────────
MAX_PHOTOS=4
# Common height the panels are normalised to. High, so it does not rescale
# more than needed: what really bounds the memory is MAX_PIXELS.
# Altura común a la que se normalizan los paneles. Alta para no reescalar de más:
# quien acota la memoria de verdad es MAX_PIXELS.
MAX_HEIGHT=2000
# Total pixel budget of the canvas. If it is exceeded, the height drops on its own.
# Presupuesto total de píxeles del lienzo. Si se pasa, la altura baja sola.
MAX_PIXELS=12000000
MAX_DOWNLOAD_BYTES=12582912
# Gap between panels. With `auto` it reproduces the one X shows: X scales the
# row to a fixed height and leaves a few pixels between pieces, so the gap is
# a proportion of the height and not an absolute number. A fixed number here
# turns the calculation off. It can be tuned per post with ?gap=N in the URL.
# Separación entre paneles. Con `auto` reproduce la que enseña X: escala la
# fila a una altura fija y deja unos píxeles entre trozos, así que el hueco
# es una proporción de la altura y no un número absoluto. Un número fijo aquí
# desactiva el cálculo. Se puede afinar por post con ?gap=N en la URL.
GAP=auto
# Geometry measured on X. It always separates by 6 CSS px (4 between borders
# + 1 of border per side), the same on desktop and mobile, but it draws the
# pieces at different heights depending on the layout, so the PROPORTION changes:
#   wide    (desktop at 100%)        piece of 700 CSS px  ->  0.857 %
#   narrow  (mobile or 300% zoom)    piece of 464 CSS px  ->  1.292 %
# It is calibrated on the narrow one, which is where the cuts fit. The values
# are physical pixels of a screenshot at DPR 3: only the ratio is used.
# Per request, ?zoom=100 uses the wide layout and ?zoom=300 the narrow one.
# Geometría medida en X. Separa siempre 6px CSS (4 entre bordes + 1 de borde
# por lado), igual en escritorio y en móvil, pero pinta los trozos a alturas
# distintas según el layout, así que la PROPORCIÓN cambia:
#   ancho    (escritorio 100%)     trozo de 700 CSS  ->  0,857 %
#   estrecho (móvil o zoom 300%)   trozo de 464 CSS  ->  1,292 %
# Se calibra sobre el estrecho, que es donde encajan los cortes. Los valores
# son píxeles físicos de una captura a DPR 3: solo se usa el cociente.
# Por petición, ?zoom=100 usa el layout ancho y ?zoom=300 el estrecho.
X_DISPLAY_HEIGHT=1393
X_DISPLAY_GAP=18
# Colour of the gap. With `transparent` you see the chat background; a CSS
# colour fixes it.
# Color del hueco. Con `transparent` se ve el fondo del chat; un color de CSS lo fija.
BG_COLOR=transparent
WEBP_QUALITY=92
JPEG_QUALITY=88

# Relative spread of heights tolerated to call it a strip: (max-min)/max.
# 0.02 = 2%.
# Dispersión relativa de alturas tolerada para decidir que es una tira:
# (max-min)/max. 0.02 = 2%.
ROW_HEIGHT_TOLERANCE=0.02
# The same over the aspect ratio (w/h). Disabled by default: requiring it would
# reject legitimate vertical cuts, where the widths vary and the heights do not.
# Lo mismo sobre el aspecto (w/h). Desactivado por defecto: exigirlo rechazaría
# cortes verticales legítimos, donde los anchos varían y las alturas no.
# ROW_ASPECT_TOLERANCE=0.05

# ── Disk cache / Caché en disco ───────────────────────────────────────────────
CACHE_DIR=./cache
CACHE_MAX_BYTES=536870912
CACHE_MAX_AGE_DAYS=30

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ── Branding / Marca ──────────────────────────────────────────────────────────
SITE_NAME=Bayeux
# Logo Discord draws in the footer of the embed. If the file is missing, it is
# not declared.
# Logo que Discord pinta en el pie del embed. Si no existe, no se declara.
BRAND_ICON=assets/icon.png
THEME_COLOR=#1d1f23
REPO_URL=https://github.com/JosueMeserom/bayeux
